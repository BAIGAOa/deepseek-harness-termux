+#if defined(__ANDROID__)
+// Termux/Android has no /bin: resolve sh/env through $PREFIX or /system/bin.
+static const char *AndroidToolPath(const char *name)
+{
+    static char buf[PATH_MAX];
+    const char *prefix = getenv("PREFIX");
+
+    if (prefix && *prefix) {
+        snprintf(buf, sizeof(buf), "%s/bin/%s", prefix, name);
+        if (access(buf, X_OK) == 0)
+            return buf;
+    }
+
+    snprintf(buf, sizeof(buf), "/system/bin/%s", name);
+    return buf;
+}
